{
  "name": "flashcards",
  "productName": "Flashcards",
  "appId": "flashcards",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first spaced-repetition flashcards",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "flashcards": "./bin/flashcards.js"
  },
  "files": [
    "bin/",
    "cli/settings.js",
    "cli/setup.js",
    "cli/doctor.js",
    "dist/",
    "README.md",
    "docs/",
    "examples/"
  ],
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "pnpm check && tsx scripts/build.ts",
    "start": "node bin/flashcards.js",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "test": "tsx --test server/*.test.ts cli/*.test.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "ts-fsrs": "^5.2.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.41.0",
    "oxlint": "^1.82.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
